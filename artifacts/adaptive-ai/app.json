{
  "expo": {
    "name": "Adaptive AI",
    "slug": "adaptive-ai",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "adaptive-ai",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/images/icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": false
    },
    "android": {
      "package": "com.adaptiveai.studyassistant",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "POST_NOTIFICATIONS"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-web-browser",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Adaptive AI to access photos you choose to explain."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Adaptive AI to record questions for transcription."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Adaptive AI to use your camera.",
          "recordAudioAndroid": false
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
