# Frontend (Expo) — safe to ship in the client bundle
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
EXPO_PUBLIC_API_URL=https://<codespace>-5000.app.github.dev

# Backend (Express) — never put these in the Expo app
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
PORT=5000
NODE_ENV=development
LOG_LEVEL=info
